 * 8) IMU / Gyroscope (BNO055)
 * ================================================================================================ */
// -- เตรียมค่าองศา (ทำใน setup() ตอนหุ่นอยู่นิ่ง)
// setAngleOffset();    // รีเซ็ตมุมปัจจุบันของหุ่นยนต์ให้เป็น 0 องศา
// SetRobotAngle();      // จำองศาปัจจุบันไว้เป็นค่าอ้างอิง (current_degree) — ต้องเรียกก่อนวิ่งตรงด้วย Gyro ทุกครั้ง
//
// -- หมุน/เลี้ยว กำหนดองศาอิสระ (ใส่ค่าบวก = ขวา, ค่าลบ = ซ้าย, ช่วง -180 ถึง 180)
// spinDegree(องศา);             // หมุนอยู่กับที่ (ล้อสองข้างสวนทาง) ด้วยความเร็วมาตรฐาน
// spinDegree(ความเร็ว, องศา);    // หมุนอยู่กับที่ กำหนดความเร็วเอง
// turnDegree(องศา);             // เลี้ยวหน้าด้วยล้อเดียว (มีเบรกหยุดนิ่งเมื่อถึงองศา)
// turnDegree(ความเร็ว, องศา);
// turnDegreeB(องศา);            // เลี้ยวถอยหลังด้วยล้อเดียว (มีเบรกหยุดนิ่งเมื่อถึงองศา)
// turnDegreeB(ความเร็ว, องศา);
//
// -- เวอร์ชัน "_none" ไม่เบรกหยุดเมื่อถึงองศา (วิ่งทะลุผ่านต่อได้ทันที) ใช้กับการเข้าโค้งต่อเนื่องแบบ S-curve
// turnDegree_none(องศา); / turnDegree_none(ความเร็ว, องศา);     // เลี้ยวหน้าด้วยล้อเดียว ไม่เบรก
// turnDegreeb_none(องศา); / turnDegreeb_none(ความเร็ว, องศา);   // เลี้ยวถอยหลังด้วยล้อเดียว ไม่เบรก
//
// ตัวอย่าง:
// turnDegree(90);     // เลี้ยวขวา 90 องศา
// turnDegree(-90);    // เลี้ยวซ้าย 90 องศา
// spinDegree(-90);    // หมุนอยู่กับที่ไปทางซ้าย 90 องศา
//
// -- หมุน/เลี้ยว แบบกำหนดความเร็ว+องศาเป๊ะๆ (มีทิศทางระบุอยู่ในชื่อฟังก์ชันแล้ว)
// SpinLG(องศา); / SpinLG(ความเร็ว, องศา);    // หมุนซ้ายอยู่กับที่ ตามองศาที่กำหนด
