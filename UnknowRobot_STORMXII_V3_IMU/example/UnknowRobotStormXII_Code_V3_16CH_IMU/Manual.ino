/* ================================================================================================
 * 4) วิ่งตามเส้นด้วย PID (พร้อมนับแยก)
 * ================================================================================================ */
// รูปแบบคำสั่งหลัก:
//   FFxx(ความเร็ว, 'คำสั่งเจอแยก');   // วิ่งตามเส้นไปข้างหน้า
//   BBxx(ความเร็ว, 'คำสั่งเจอแยก');   // วิ่งตามเส้นถอยหลัง
// ตัวอักษร 'คำสั่งเจอแยก' ดูตารางทั้งหมดได้ที่หมวด 10
//
// -- เลือกตำแหน่งเซนเซอร์คู่ที่ใช้ตรวจจับแยก
// FFC(speed, select);   // ใช้เซนเซอร์คู่กลางตรวจจับแยก
// FFL(speed, select);   // ใช้เซนเซอร์คู่ซ้ายตรวจจับแยก
// FFR(speed, select);   // ใช้เซนเซอร์คู่ขวาตรวจจับแยก
// FFNUM(speed, select, ตำแหน่งเซนเซอร์ 0-7);   // เลือกตำแหน่งเซนเซอร์เองสำหรับตรวจจับแยก
// BBC(speed, select); / BBL(speed, select); / BBR(speed, select); / BBNUM(speed, select, 0-7);   // เหมือนด้านบนแต่ถอยหลัง
//
// -- วิ่งตามเวลา / ตามระยะทาง (ไม่ตรวจจับแยกระหว่างทาง)
// FFtimer(speed, เวลา_ms);                 // วิ่งไปข้างหน้าตามเวลา
// BBtimer(speed, เวลา_ms);                 // ถอยหลังตามเวลา
// FFtimer(speed, เวลา_ms, select);         // วิ่งไปข้างหน้าตามเวลา จบแล้วทำคำสั่งเจอแยกต่อ
// BBtimer(speed, เวลา_ms, select);
// FFcm(speed, ระยะทาง_cm);                 // วิ่งไปข้างหน้าตามระยะทาง (โดยประมาณ)
// BBcm(speed, ระยะทาง_cm);                 // ถอยหลังตามระยะทาง (โดยประมาณ)
// FFcm(speed, ระยะทาง_cm, select);         // เหมือนบน จบแล้วทำคำสั่งเจอแยกต่อ
// BBcm(speed, ระยะทาง_cm, select);
//
// -- วิ่งจนกว่าจะเจอเส้นขาว / เส้นดำ
// FFWhite(speed, select);                  // วิ่งไปข้างหน้าจนเซนเซอร์หน้าเจอขาวทั้งหมด
// BBWhite(speed, select);                  // ถอยหลังจนเซนเซอร์หลังเจอขาวทั้งหมด
// FFBlack(speedL, speedR, select);         // เดินหน้าจนเซนเซอร์หน้าเจอเส้นดำ
// BBBlack(speedL, speedR, select);         // ถอยหลังจนเซนเซอร์หลังเจอเส้นดำ
//
// -- กำหนดค่า KP, KD เอง (ไม่ใช้ค่าจาก SetKpKd/SetKpKdBack) เติมพารามิเตอร์ kp, kd ต่อจากความเร็วได้กับ
//    FFC/FFL/FFR/FFNUM/BBC/BBL/BBR/BBNUM/FFtimer/BBtimer/FFWhite/BBWhite ทุกตัว
// FFC(speed, kp, kd, select);
// BBL(speed, kp, kd, select);
// FFtimer(speed, kp, kd, เวลา_ms, select);
//
// -- วิ่งวนโค้ง (Circle) — สลับไปใช้ตำแหน่งเส้นขอบซ้าย/ขวา (set_position_line_l / set_position_line_r)
//    แทนตำแหน่งเส้นกลางชั่วคราว ทำให้หุ่นยนต์วิ่งเบี่ยงกินโค้งซ้าย/ขวา แล้วคืนค่าตำแหน่งเดิมให้อัตโนมัติเมื่อจบคำสั่ง
// -- วิ่งจนเจอเส้น/แยกด้านที่กำหนด (เซนเซอร์หน้าสุดขอบซ้าย F[0] หรือขวาสุด F[15])
// FFCirCleL(speed, select); / FFCirCleR(speed, select);   // วิ่งกินโค้งซ้าย/ขวา ไปข้างหน้า จนเจอแยก
// BBCirCleL(speed, select); / BBCirCleR(speed, select);   // วิ่งกินโค้งซ้าย/ขวา ถอยหลัง จนเจอแยก
//
// -- วิ่งกินโค้งตามเวลา
// FFtimerCirCleL(speed, เวลา_ms); / FFtimerCirCleL(speed, เวลา_ms, select);   // วิ่งกินโค้งซ้าย ไปข้างหน้า ตามเวลา
// FFtimerCirCleR(speed, เวลา_ms); / FFtimerCirCleR(speed, เวลา_ms, select);   // วิ่งกินโค้งขวา ไปข้างหน้า ตามเวลา
// BBtimerCirCleL(speed, เวลา_ms); / BBtimerCirCleL(speed, เวลา_ms, select);   // วิ่งกินโค้งซ้าย ถอยหลัง ตามเวลา
// BBtimerCirCleR(speed, เวลา_ms); / BBtimerCirCleR(speed, เวลา_ms, select);   // วิ่งกินโค้งขวา ถอยหลัง ตามเวลา
//
// -- วิ่งกินโค้งตามระยะทาง (โดยประมาณ)
// FFcmCirCleL(speed, ระยะทาง_cm); / FFcmCirCleL(speed, ระยะทาง_cm, select);   // วิ่งกินโค้งซ้าย ไปข้างหน้า ตามระยะทาง
// FFcmCirCleR(speed, ระยะทาง_cm); / FFcmCirCleR(speed, ระยะทาง_cm, select);   // วิ่งกินโค้งขวา ไปข้างหน้า ตามระยะทาง
// BBcmCirCleL(speed, ระยะทาง_cm); / BBcmCirCleL(speed, ระยะทาง_cm, select);   // วิ่งกินโค้งซ้าย ถอยหลัง ตามระยะทาง
// BBcmCirCleR(speed, ระยะทาง_cm); / BBcmCirCleR(speed, ระยะทาง_cm, select);   // วิ่งกินโค้งขวา ถอยหลัง ตามระยะทาง
//
// ตัวอย่าง: วิ่งกินโค้งซ้ายไปข้างหน้าความเร็ว 40 นาน 1.2 วินาที แล้วหยุด
// FFtimerCirCleL(40, 1200, 's');
//
// ตัวอย่าง: วิ่งไปข้างหน้าความเร็ว 50 ด้วยเซนเซอร์คู่ซ้าย เจอแยกให้เลี้ยวซ้าย
// FFL(50, 'l');
//
// ตัวอย่าง: วิ่งไปข้างหน้า 2 วินาที แล้วเลี้ยวขวาที่แยก
// FFtimer(40, 2000, 'r');
//
// ตัวอย่าง: วิ่งไปข้างหน้า 100 ซม. ด้วยเซนเซอร์คู่กลาง แล้วหยุด
// FFcm(50, 100, 's');


