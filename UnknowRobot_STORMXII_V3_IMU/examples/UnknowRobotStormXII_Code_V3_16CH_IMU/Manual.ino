// รูปแบบ:  FFxx(speed, select) = วิ่งไปข้างหน้า     BBxx(speed, select) = ถอยหลัง
// เมื่อเจอแยกจะทำตาม select (ดูหมวด 10)
//
// ---------- 4.1 วิ่งจนเจอแยก — เลือกเซนเซอร์ที่ใช้จับแยก ----------
// FFC(speed, select);                             // เซนเซอร์คู่กลาง (แยกแคบ-กลาง)
// FFC2(speed, select);                            // เซนเซอร์ริมสุดซ้าย-ขวา (0 และ 15) พร้อมกัน (แยกกว้างเต็มบอร์ด)
// FFL(speed, select);                             // เซนเซอร์คู่ซ้าย
// FFR(speed, select);                             // เซนเซอร์คู่ขวา
// FFL0(speed, select);                            // เหมือน FFL + เซนเซอร์ริมซ้ายสุด (ตัวที่ 0) สำหรับแยกกว้าง
// FFR15(speed, select);                           // เหมือน FFR + เซนเซอร์ริมขวาสุด (ตัวที่ 15) สำหรับแยกกว้าง
// FFNUM(speed, select, 0-15);                     // เลือกตำแหน่งเซนเซอร์จับแยกเอง
// FFSUM(speed, select, sum);                      // ผลรวมเซนเซอร์หน้า F[0]..F[15] >= sum (0-16000) เช่น 4000 ≈ ดำ 4 ตัว
// BBC / BBC2 / BBL / BBR / BBL0 / BBR15 / BBNUM / BBSUM   // เหมือนด้านบนทุกตัว แต่ถอยหลัง
//
// ---------- 4.2 วิ่งตามเวลา / ระยะทาง (ไม่จับแยกระหว่างทาง) ----------
// FFtimer(speed, ms);                             // วิ่งไปข้างหน้าตามเวลา
// BBtimer(speed, ms);                             // ถอยหลังตามเวลา
// FFcm(speed, cm);                                // วิ่งไปข้างหน้าตามระยะทาง
// BBcm(speed, cm);                                // ถอยหลังตามระยะทาง
// FFtimer / BBtimer / FFcm / BBcm(..., select);   // ใส่ select ต่อท้ายได้ทุกตัว = จบแล้วทำคำสั่ง select ต่อ
// ใส่ kp / kd เองได้ (ดู 4.5)
//
// ---------- 4.3 วิ่งจนเจอขาว / ดำ ----------
// FFWhite(speed, select);            // วิ่งไปข้างหน้าจนเซนเซอร์หน้าเป็นขาวทั้งหมด
// BBWhite(speed, select);            // ถอยหลังจนเซนเซอร์หลังเป็นขาวทั้งหมด
// FFBlack(speedL, speedR, select);   // เดินหน้าจนเซนเซอร์หน้าเจอเส้นดำ
// BBBlack(speedL, speedR, select);   // ถอยหลังจนเซนเซอร์หลังเจอเส้นดำ
//
// ---------- 4.4 วิ่งกินโค้ง (CirCle) — ใช้ตำแหน่งเส้น set_position_line_l / _r แทนเส้นกลางชั่วคราว ----------
// FFCirCleL(speed, select); / FFCirCleR(speed, select);     // กินโค้งซ้าย / ขวา ไปข้างหน้า จนเจอแยก
// BBCirCleL(speed, select); / BBCirCleR(speed, select);     // กินโค้งซ้าย / ขวา ถอยหลัง จนเจอแยก
// FFtimerCirCleL(speed, ms); / FFtimerCirCleR(speed, ms);   // กินโค้งซ้าย / ขวา ไปข้างหน้า ตามเวลา
// BBtimerCirCleL(speed, ms); / BBtimerCirCleR(speed, ms);   // กินโค้งซ้าย / ขวา ถอยหลัง ตามเวลา
// FFcmCirCleL(speed, cm); / FFcmCirCleR(speed, cm);         // กินโค้งซ้าย / ขวา ไปข้างหน้า ตามระยะทาง
// BBcmCirCleL(speed, cm); / BBcmCirCleR(speed, cm);         // กินโค้งซ้าย / ขวา ถอยหลัง ตามระยะทาง
// คำสั่ง timer / cm ของกลุ่มนี้ใส่ select ต่อท้ายได้ เช่น FFtimerCirCleL(40, 1200, 's');
// ทุกตัวในกลุ่มนี้ใส่ kp / kd เองได้ (ดู 4.5)
//
// ---------- 4.5 กำหนด kp, kd เฉพาะคำสั่ง (แทนค่าจากตาราง Set_KP_KD) ----------
// ใส่ kp (หรือ kp, kd) ต่อจาก speed ได้กับคำสั่งเดินตามเส้นด้วย PID ทุกตัว:
//   FFC / FFC2 / FFL / FFR / FFL0 / FFR15 / FFNUM / FFSUM / FFWhite / FFtimer / FFcm
//   FFCirCleL/R / FFtimerCirCleL/R / FFcmCirCleL/R  และฝั่ง BB ทุกตัวที่คู่กัน
// (FFBlack / BBBlack ไม่ใช้ PID จึงไม่มี)
//
// --- วิ่งจนเจอแยก ---
// FFC(speed, kp, select);                  // กำหนด kp อย่างเดียว (kd ใช้ค่าจากตารางความเร็ว)
// FFC(speed, kp, kd, select);              // กำหนดทั้ง kp และ kd
// BBL(speed, kp, kd, select);
// FFNUM(speed, kp, kd, select, n);         // ตัวที่มีพารามิเตอร์ต่อท้าย ใส่ kp/kd หลัง speed เหมือนกัน
// FFCirCleL(speed, kp, [kd,] select);      // BBCirCleL / FFCirCleR / BBCirCleR แบบเดียวกัน
//
// --- ตามเวลา / ระยะทาง ( [ ] = ใส่หรือไม่ใส่ก็ได้ ) ---
// FFtimer(speed, kp, ms);        FFtimer(speed, kp, kd, ms);        // ตามเวลา
// FFtimer(speed, kp, ms, select);  FFtimer(speed, kp, kd, ms, select);
// FFcm(speed, kp, cm);           FFcm(speed, kp, kd, cm);           // ตามระยะทาง (cm เป็นจำนวนเต็ม)
// FFcm(speed, kp, cm, select);   FFcm(speed, kp, kd, cm, select);
// BBtimer / BBcm(speed, kp, [kd,] ms หรือ cm [, select]);           // ถอยหลัง แบบเดียวกัน
// FFtimerCirCleL(speed, kp, [kd,] ms [, select]);   // ...CirCleR / BBtimerCirCleL / BBtimerCirCleR แบบเดียวกัน
// FFcmCirCleL(speed, kp, [kd,] cm [, select]);      // ...CirCleR / BBcmCirCleL / BBcmCirCleR แบบเดียวกัน
//
// * ใส่ kp เป็นทศนิยม เช่น 0.02  (ใส่ค่าติดลบ = ใช้ค่าจากตาราง เช่น FFC(50, -1, 0.3, 'p') กำหนดแค่ kd)
// * คำสั่ง timer / cm ที่ใส่ kp ต้องใส่ ms / cm เป็นจำนวนเต็ม เช่น FFcm(50, 0.02, 30) ไม่ใช่ 30.5
//
// ---------- 4.6 ดูค่าตำแหน่งเส้น (debug) — พิมพ์ออก Serial Monitor ต่อเนื่อง ----------
